{
  "name": "identity-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:https": "vite --host 0.0.0.0 --mode https",
    "build": "tsc -b && vite build && node scripts/finalize-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "setup:vision": "node scripts/setup-vision.mjs",
    "publish:pages": "npm run setup:vision && npm run build && node scripts/publish-pages.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
